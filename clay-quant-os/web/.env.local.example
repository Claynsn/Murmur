# Clay Quant OS — frontend environment.
# Copy to .env.local and fill in. All values are OPTIONAL for the MVP:
# if Supabase vars are missing the app still runs (persistence is skipped).

# URL of the Python backtest service.
BACKTEST_API_URL=http://localhost:8000

# Supabase project (optional for local single-user mode).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
